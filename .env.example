# =============================================
# A股轮动策略交易系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# =============================================

# ==================== 数据库配置 ====================
DB_USER=admin
DB_PASSWORD=your_secure_db_password_here
DB_NAME=rotation_db
DB_PORT=5432

# ==================== Redis配置 ====================
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=your_secure_redis_password_here

# ==================== InfluxDB配置 ====================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=your_secure_influxdb_password_here
INFLUXDB_TOKEN=your_secure_influxdb_token_here
INFLUXDB_ORG=rotation
INFLUXDB_BUCKET=market_data
INFLUXDB_PORT=8086

# ==================== RabbitMQ配置 ====================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# ==================== JWT配置 ====================
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRATION=86400000

# ==================== 服务端口配置 ====================
AUTH_PORT=8001
STRATEGY_PORT=8002
DATA_COLLECTOR_PORT=8003
SIGNAL_PORT=8004
FUND_PORT=8005
SCHEDULER_PORT=8006
AI_DECISION_PORT=8007
FRONTEND_PORT=80

# ==================== AI 模型配置 ====================
# 支持的提供商: xiaomi, deepseek, openai, qwen, claude, siliconflow, ollama
AI_PROVIDER=deepseek                        # openai / ollama
AI_API_KEY=your_api_key_here                # API Key
AI_BASE_URL=https://api.deepseek.com/v1    # API 地址
AI_MODEL=deepseek-v4-pro                    # 模型名称
AI_TEMPERATURE=0.7                          # 温度参数 (0-1)
AI_MAX_TOKENS=2000                          # 最大输出 token

# 预置提供商 Base URL:
# 小米: https://api.xiaomi.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# Claude: https://api.anthropic.com/v1
# 硅基流动: https://api.siliconflow.cn/v1

# Ollama 本地模型配置 (当 AI_PROVIDER=ollama 时生效)
# Docker 环境使用 host.docker.internal 访问宿主机
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# ==================== 钉钉推送（可选）====================
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# ==================== 企业微信推送（可选）====================
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=

# ==================== 日志级别 ====================
LOG_LEVEL=INFO
