# =============================================
# A股轮动策略交易系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# =============================================

# ==================== 数据库配置 ====================
DB_USER=admin
DB_PASSWORD=your_secure_db_password_here
DB_NAME=rotation_db
DB_PORT=5432

# ==================== Redis配置 ====================
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=your_secure_redis_password_here

# ==================== InfluxDB配置 ====================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=your_secure_influxdb_password_here
INFLUXDB_TOKEN=your_secure_influxdb_token_here
INFLUXDB_ORG=rotation
INFLUXDB_BUCKET=market_data
INFLUXDB_PORT=8086

# ==================== RabbitMQ配置 ====================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# ==================== JWT配置 ====================
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRATION=86400000

# ==================== 服务端口配置 ====================
AUTH_PORT=8001
STRATEGY_PORT=8002
DATA_COLLECTOR_PORT=8003
SIGNAL_PORT=8004
FUND_PORT=8005
SCHEDULER_PORT=8006
FRONTEND_PORT=80

# ==================== 钉钉推送（可选）====================
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# ==================== 企业微信推送（可选）====================
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=

# ==================== 日志级别 ====================
LOG_LEVEL=INFO
